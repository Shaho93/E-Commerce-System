// Cloudflare-Konfiguration für die Browser-Demo (kostenloser Tarif).
// Liefert den Vite-Build (dist/) aus; unbekannte Pfade bekommen index.html (Single-Page-App).
{
  "name": "kindiit-e-commerce",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // nötig für Vorschau-Builds von develop/feature-Branches (wrangler preview)
  "previews": {}
}
